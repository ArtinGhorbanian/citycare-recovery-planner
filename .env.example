# CityCare Recovery Planner local configuration
# Copy this file to .env and keep .env private.

DATASET_PATH=hospital_crisis_realistic_dataset_50000.csv
PORT=5000
DEBUG=false

# Optional OpenAI-compatible language-model rewriting.
# Keep disabled for deterministic, offline-safe operation.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=your_provider_api_key_here
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.2

